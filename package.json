{
  "name": "theodore-portfolio-notes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content:index": "node scripts/generate-indexes.mjs",
    "content:new": "node scripts/new-article.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:index": "node scripts/generate-indexes.mjs --check",
    "check:types": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check": "npm run check:content && npm run check:index && npm run check:types",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/copy-public-sources.mjs && node scripts/check-built-site.mjs && node scripts/prepare-sites-dist.mjs",
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.1.4",
    "gray-matter": "4.0.3",
    "katex": "0.18.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "cross-env": "10.1.0",
    "typescript": "6.0.3"
  }
}
